{
  "name": "caderno-de-estudos",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node --env-file-if-exists=.env.local server/index.js",
    "build": "vite build",
    "start": "vite build && node --env-file-if-exists=.env.local server/index.js",
    "import-backup": "node server/import-backup.js",
    "test": "node --test \"tests/*.test.js\""
  },
  "devDependencies": {
    "vite": "^7.1.5"
  }
}
